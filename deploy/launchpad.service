[Unit]
Description=Launchpad job radar on HTTPS port 443
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=launchpad
Group=launchpad
WorkingDirectory=/opt/launchpad/backend
EnvironmentFile=/etc/launchpad/launchpad.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/launchpad/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 443 --workers 1 --ssl-certfile /etc/launchpad/tls/fullchain.pem --ssl-keyfile /etc/launchpad/tls/server-key.pem --no-proxy-headers --no-access-log --limit-concurrency 32 --timeout-keep-alive 5
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillSignal=SIGTERM
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=launchpad
StateDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
